            type: 'STRING'
          },

          must_have_points: {
            type: 'STRING'
          },

          value_additions: {
            type: 'STRING'
          },

          essential_keywords: {
            type: 'STRING'
          },

          examples_data: {
            type: 'STRING'
          },

          best_conclusion: {
            type: 'STRING'
          },

          missing_extra_improvements: {
            type: 'STRING'
          },

          topper_edge: {
            type: 'STRING'
          },

          overall_feedback: {
            type: 'STRING'
          },

          my_one_learning: {
            type: 'STRING'
          },

          intro_feedback: {
            type: 'STRING'
          },

          body_feedback: {
            type: 'STRING'
          },

          conclusion_feedback: {
            type: 'STRING'
          }

        },

        required: [

          'question_date',
          'paper',
          'subject',
          'subtopic',
          'question',
          'marks',
          'max_marks',
          'demand',
          'demand_percentage',
          'directive',
          'best_introduction',
          'ideal_subheadings',
          'must_have_points',
          'value_additions',
          'essential_keywords',
          'examples_data',
          'best_conclusion',
          'missing_extra_improvements',
          'topper_edge',
          'overall_feedback',
          'my_one_learning',
          'intro_feedback',
          'body_feedback',
          'conclusion_feedback'

        ]

      }

    }

  };


  const options = {

    method:
      'post',

    contentType:
      'application/json',

    payload:
      JSON.stringify(payload),

    muteHttpExceptions:
      true

  };


  console.log(
    'Gemini model: ' +
    model
  );

  console.log(
    'Gemini attempt 1/1'
  );


  let response;

  try {

    response =
      UrlFetchApp.fetch(
        url,
        options
      );

  } catch (fetchError) {

    /*
     * Network / fetch failures are treated as transient
     * when using the primary model. The fallback will run
     * after 15 minutes.
     */

    if (
      model === CONFIG.MODEL
    ) {

      const retryError =
        new Error(
          'Gemini fetch error: ' +
          fetchError.message
        );

      retryError.retryable =
        true;

      retryError.fallbackScheduled =
        true;

      scheduleGeminiFallbackRetry();

      throw retryError;

    }

    throw fetchError;

  }


  const status =
    response.getResponseCode();


  const body =
    response.getContentText();


  console.log(
    'Gemini HTTP STATUS: ' +
    status
  );


  /*
   * SUCCESS
   */

  if (
    status >= 200 &&
    status < 300
  ) {

    let parsed;

    try {

      parsed =
        JSON.parse(
          body
        );

    } catch (error) {

      throw new Error(
        'Gemini returned invalid JSON: ' +
        error.message
      );

    }


    if (
      !parsed.candidates ||
      !parsed.candidates.length
    ) {

      throw new Error(
        'Gemini returned no candidates.'
      );

    }


    const parts =
      parsed.candidates[0]
        .content
        .parts;


    if (
      !parts ||
      !parts.length ||
      !parts[0].text
    ) {

      throw new Error(
        'Gemini returned no usable text.'
      );

    }


    const output =
      parts[0].text;


    console.log(
      'Gemini output received.'
    );


    let result;


    try {

      result =
        JSON.parse(
          output
        );

    } catch (error) {

      /*
       * Sometimes JSON may be wrapped in markdown.
       */

      const cleaned =
        output
          .replace(/^```json\s*/i, '')
          .replace(/^```\s*/i, '')
          .replace(/\s*```$/i, '')
          .trim();


      try {

        result =
          JSON.parse(
            cleaned
          );

      } catch (secondError) {

        throw new Error(
          'Gemini output was not valid JSON: ' +
          secondError.message +
          '\nRaw output:\n' +
          output
        );

      }

    }


    return result;

  }


  /*
   * Only transient service/capacity errors trigger
   * the 15-minute fallback.
   */

  const retryableStatuses = [
    429,
    500,
    502,
    503,
    504
  ];


  if (
    retryableStatuses.includes(
      status
    )
  ) {

    /*
     * Primary model failed:
     * schedule one-time fallback run.
     */

    if (
      model === CONFIG.MODEL
    ) {

      const retryError =
        new Error(
          'Gemini API error ' +
          status +
          '. Fallback to ' +
          CONFIG.FALLBACK_MODEL +
          ' scheduled in approximately 1 minutes.'
        );

      retryError.retryable =
        true;

      retryError.fallbackScheduled =
        true;

      retryError.httpStatus =
        status;


      scheduleGeminiFallbackRetry();


      throw retryError;

    }


    /*
     * Fallback model also failed.
     * Do not create an infinite retry loop.
     */

    throw new Error(
      'Gemini fallback model ' +
      model +
      ' also failed with ' +
      status +
      ': ' +
      body
    );

  }


  /*
   * Non-retryable errors:
   * 400, 401, 403, 404, etc.
   */

  throw new Error(
    'Gemini API error ' +
    status +
    ': ' +
    body
  );

}


/***********************
 * 6A. SCHEDULE GEMINI FALLBACK
 ***********************/

function scheduleGeminiFallbackRetry() {

  const triggers =
    ScriptApp.getProjectTriggers();


  const alreadyScheduled =
    triggers.some(
      function(trigger) {

        return trigger.getHandlerFunction() ===
          'processGeminiFallbackRetry';

      }
    );


  if (
    alreadyScheduled
  ) {

    console.log(
      'Gemini fallback trigger already exists.'
    );

    return;

  }


  ScriptApp
    .newTrigger(
      'processGeminiFallbackRetry'
    )
    .timeBased()
    .after(
      0.1 * 60 * 1000
    )
    .create();


  console.log(
    'Gemini fallback scheduled for approximately 15 minutes later.'
  );

}


/***********************
 * 6B. GEMINI FALLBACK RUN
 ***********************/

function processGeminiFallbackRetry() {

  /*
   * Delete the one-time fallback trigger first.
   */

  const triggers =
    ScriptApp.getProjectTriggers();


  triggers.forEach(
    function(trigger) {

      if (
        trigger.getHandlerFunction() ===
        'processGeminiFallbackRetry'
      ) {

        ScriptApp.deleteTrigger(
          trigger
        );

      }

    }
  );


  const lock =
    LockService.getScriptLock();


  try {

    lock.waitLock(30000);


    console.log(
      '=========================================='
    );

    console.log(
      '15-MINUTE GEMINI FALLBACK RETRY STARTED'
    );

    console.log(
      '=========================================='
    );


    const apiKey =
      getGeminiApiKey();


    if (!apiKey) {

      throw new Error(
        'Gemini API key not found. Add GEMINI_API_KEY to Script Properties.'
      );

    }


    const sheet =
      getSheet();


    ensureHeaders(
      sheet
    );


    const retryPendingIds =
      getRetryPendingPdfIds(
        sheet
      );


    if (
      retryPendingIds.size === 0
    ) {

      console.log(
        'No PDFs are waiting for fallback.'
      );

      return;

    }


    const processedIds =
      getProcessedPdfIds(
        sheet
      );


    const folder =
      DriveApp.getFolderById(
        CONFIG.PDF_FOLDER_ID
      );


    const files =
      folder.getFilesByType(
        MimeType.PDF
      );


    let attempted =
      0;


    while (
      files.hasNext() &&
      attempted < CONFIG.MAX_FILES_PER_RUN
    ) {

      const file =
        files.next();


      const fileId =
        file.getId();


      if (
        processedIds.has(
          fileId
        )
      ) {

        continue;

      }


      if (
        !retryPendingIds.has(
          fileId
        )
      ) {

        continue;

      }


      attempted++;


      console.log(
        'FALLBACK PDF: ' +
        file.getName()
      );


      try {

        processSinglePdf(
          file,
          sheet,
          apiKey,
          CONFIG.FALLBACK_MODEL
        );


        console.log(
          'FALLBACK PROCESSING SUCCESSFUL: ' +
          file.getName()
        );


        /*
         * Remove the old RETRY_PENDING row so the
         * successful result is the only record for
         * this PDF.
         */

        removeRetryPendingRows(
          sheet,
          fileId
        );


      } catch (error) {

        console.error(
          'FALLBACK PROCESSING FAILED: ' +
          file.getName() +
          ' | ' +
          error.message
        );


        writeFailureRow(
          sheet,
          file,
          error
        );

      }

    }


    console.log(
      '=========================================='
    );

    console.log(
      'FALLBACK RETRY FINISHED'
    );

    console.log(
      'Attempted: ' +
      attempted
    );

    console.log(
      '=========================================='
    );


  } finally {

    try {

      lock.releaseLock();

    } catch (e) {}

  }

}


/***********************
 * 6C. RETRY-PENDING IDS
 ***********************/

function getRetryPendingPdfIds(
  sheet
) {

  const ids =
    new Set();


  if (
    sheet.getLastRow() < 2
  ) {

    return ids;

  }


  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getValues()[0];


  const pdfIdColumn =
    headers.indexOf(
      'PDF ID'
    ) + 1;


  const statusColumn =
    headers.indexOf(
      'Status'
    ) + 1;


  if (
    pdfIdColumn === 0 ||
    statusColumn === 0
  ) {

    return ids;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        sheet.getLastColumn()
      )
      .getValues();


  values.forEach(
    function(row) {

      const pdfId =
        row[pdfIdColumn - 1];

      const status =
        String(
          row[statusColumn - 1] ||
          ''
        );


      if (
        pdfId &&
        status.indexOf(
          'RETRY_PENDING'
        ) === 0
      ) {

        ids.add(
          String(
            pdfId
          )
        );

      }

    }
  );


  return ids;

}


/***********************
 * 6D. REMOVE OLD RETRY ROWS
 ***********************/

function removeRetryPendingRows(
  sheet,
  pdfId
) {

  const headers =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getValues()[0];


  const pdfIdColumn =
    headers.indexOf(
      'PDF ID'
    ) + 1;


  const statusColumn =
    headers.indexOf(
      'Status'
    ) + 1;


  if (
    pdfIdColumn === 0 ||
    statusColumn === 0 ||
    sheet.getLastRow() < 2
  ) {

    return;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        sheet.getLastColumn()
      )
      .getValues();


  for (
    let i = values.length - 1;
    i >= 0;
    i--
  ) {

    const row =
      values[i];


    const rowPdfId =
      String(
        row[pdfIdColumn - 1] ||
        ''
      );


    const status =
      String(
        row[statusColumn - 1] ||
        ''
      );


    if (
      rowPdfId === String(pdfId) &&
      status.indexOf(
        'RETRY_PENDING'
      ) === 0
    ) {

      sheet.deleteRow(
        i + 2
      );

    }

  }

}


