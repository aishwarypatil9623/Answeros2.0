function safeValue(
  value
) {

  if (
    value === null ||
    value === undefined
  ) {

    return '';

  }


  return String(
    value
  ).trim();

}


/***********************
 * 10. GEMINI API KEY
 ***********************/

function getGeminiApiKey() {

  const properties =
    PropertiesService
      .getScriptProperties();


  return properties.getProperty(
    'GEMINI_API_KEY'
  );

}


/***********************
 * 11. GET SHEET
 ***********************/

function getSheet() {

  const ss =
    SpreadsheetApp.getActiveSpreadsheet();


  if (!ss) {

    throw new Error(
      'This script is not bound to a Google Spreadsheet.'
    );

  }


  let sheet =
    ss.getSheetByName(
      CONFIG.SHEET_NAME
    );


  if (!sheet) {

    sheet =
      ss.insertSheet(
        CONFIG.SHEET_NAME
      );

  }


  return sheet;

}


/***********************
 * 12. ENSURE HEADERS
 ***********************/

function ensureHeaders(
  sheet
) {

  /*
   * If completely empty,
   * write final headers.
   */

  if (
    sheet.getLastColumn() === 0
  ) {

    sheet
      .getRange(
        1,
        1,
        1,
        HEADERS.length
      )
      .setValues([
        HEADERS
      ]);


    formatHeaders(
      sheet
    );


    return;

  }


  /*
   * If existing sheet has old headers,
   * do NOT silently mix old and new schemas.
   *
   * setupFinalSystem() should be used
   * to create the clean final sheet.
   */

  const currentHeaders =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getValues()[0];


  const matches =
    HEADERS.every(
      function(header, index) {

        return (
          currentHeaders[index] ===
          header
        );

      }
    );


  if (!matches) {

    throw new Error(
      'Sheet headers do not match the current ' +
      HEADERS.length +
      '-column system. ' +
      'Run setupFinalSystem() once to create the correct sheet.'
    );

  }


  formatHeaders(
    sheet
  );

}


/***********************
 * 13. FORMAT HEADERS
 ***********************/

function formatHeaders(
  sheet
) {

  const lastColumn =
    sheet.getLastColumn();


  sheet
    .getRange(
      1,
      1,
      1,
      lastColumn
    )
    .setFontWeight(
      'bold'
    );


  sheet.setFrozenRows(
    1
  );


  sheet
    .getRange(
      1,
      1,
      sheet.getMaxRows(),
      lastColumn
    )
    .setWrapStrategy(
      SpreadsheetApp.WrapStrategy.WRAP
    );


  /*
   * Reasonable widths, mapped to the new column order.
   * Value Additions and Examples/Data given real room (500px).
   */

  const widths = {

    1: 110,   // Question Date
    2: 70,    // Paper
    3: 130,   // Subject
    4: 200,   // Subtopic
    5: 110,   // Directive

    6: 70,    // Marks
    7: 90,    // Max Marks
    8: 110,   // % of Demand Addressed
    9: 90,    // Word Count

    10: 380,  // Question
    11: 320,  // Demand of the Question

    12: 260,  // Intro Feedback
    13: 260,  // Body Feedback
    14: 260,  // Conclusion Feedback
    15: 280,  // Overall Feedback
    16: 300,  // Missing / Extra Improvements
    17: 280,  // Topper Edge

    18: 300,  // Best Introduction
    19: 280,  // Ideal Subheadings
    20: 340,  // Must-Have Points
    21: 300,  // Best Conclusion
    22: 500,  // Value Additions — given real room
    23: 220,  // Essential Keywords
    24: 500,  // Examples/Data — given real room
    25: 260,  // My One Learning

    26: 220,  // PDF Link
    27: 250,  // PDF ID
    28: 100,  // Status

    29: 100   // Marks Verified — now last

  };


  Object.keys(
    widths
  ).forEach(
    function(column) {

      sheet.setColumnWidth(
        Number(column),
        widths[column]
      );

    }
  );

}


/***********************
 * 14. DUPLICATE PROTECTION
 ***********************/

function getProcessedPdfIds(
  sheet
) {

  const ids =
    new Set();


  if (
    sheet.getLastRow() < 2
  ) {

    return ids;

  }


  const headerRow =
    sheet
      .getRange(
        1,
        1,
        1,
        sheet.getLastColumn()
      )
      .getValues()[0];


  const pdfIdColumn =
    headerRow.indexOf(
      'PDF ID'
    ) + 1;


  const statusColumn =
    headerRow.indexOf(
      'Status'
    ) + 1;


  if (
    pdfIdColumn === 0 ||
    statusColumn === 0
  ) {

    return ids;

  }


  const values =
    sheet
      .getRange(
        2,
        1,
        sheet.getLastRow() - 1,
        sheet.getLastColumn()
      )
      .getValues();


  values.forEach(
    function(row) {

      const pdfId =
        row[pdfIdColumn - 1];

      const status =
        String(
          row[statusColumn - 1] ||
          ''
        );


      /*
       * Only a successful PROCESSED row counts
       * as processed.
       *
       * FAILED / RETRY_PENDING rows remain eligible
       * for another attempt.
       */

      if (
        pdfId &&
        status === 'PROCESSED'
      ) {

        ids.add(
          String(
            pdfId
          )
        );

      }

    }
  );


  return ids;

}


/***********************
 * 14A. RETRYABLE FAILURE STATUS
 ***********************/

function writeRetryPendingRow(
  sheet,
  file,
  error
) {

  const filenameDate =
    extractDateFromFilename(
      file.getName()
    );


  const row =
    new Array(
      HEADERS.length
    ).fill('');


  const dateCol =
    HEADERS.indexOf(
      'Question Date'
    );

  const linkCol =
    HEADERS.indexOf(
      'PDF Link'
    );

  const idCol =
    HEADERS.indexOf(
      'PDF ID'
    );

  const statusCol =
    HEADERS.indexOf(
      'Status'
    );


  row[dateCol] =
    filenameDate;

  row[linkCol] =
    `=HYPERLINK("${file.getUrl()}","${file.getName()}")`;

  row[idCol] =
    file.getId();

  row[statusCol] =
    'RETRY_PENDING: ' +
    error.message;


  sheet.appendRow(
    row
  );


  sortAnswersByDate(
    sheet
  );

}


/***********************
 * 14B. WRITE FAILURE ROW
 ***********************/

function writeFailureRow(
  sheet,
  file,
  error
) {

  /*
   * If the error came from a transient primary-model
   * failure, preserve it as RETRY_PENDING so the
   * 15-minute fallback run knows exactly what to retry.
   */

  if (
    error &&
    error.fallbackScheduled
  ) {

    writeRetryPendingRow(
      sheet,
      file,
      error
    );

    return;

  }


  const filenameDate =
    extractDateFromFilename(
      file.getName()
    );


  const row =
    new Array(
      HEADERS.length
    ).fill('');


  const dateCol =
    HEADERS.indexOf(
      'Question Date'
    );

  const linkCol =
    HEADERS.indexOf(
      'PDF Link'
    );

  const idCol =
    HEADERS.indexOf(
      'PDF ID'
    );

  const statusCol =
    HEADERS.indexOf(
      'Status'
    );


  row[dateCol] =
    filenameDate;

  row[linkCol] =
    `=HYPERLINK("${file.getUrl()}","${file.getName()}")`;

  row[idCol] =
    file.getId();

  row[statusCol] =
    'FAILED: ' +
    error.message;


  sheet.appendRow(
    row
  );


  sortAnswersByDate(
    sheet
  );

}


/***********************
 * 15. WRITE FAILURE ROW
 *
 * Looks up column positions by header NAME rather than
 * hardcoded index, so future reorders can't silently
 * misplace PDF Link / PDF ID / Status again.
 ***********************/

function writeFailureRow(
  sheet,
  file,
  error
) {

  const filenameDate =
    extractDateFromFilename(
