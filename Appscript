/***********************
 * 16. SORT SHEET BY DATE
 *
 * Newest first. Called after EVERY write —
 * success (in processSinglePdf) and failure
 * (in writeFailureRow) — so the sheet is
 * always current, not just after failures.
 ***********************/

function sortAnswersByDate(
  sheet
) {

  const lastRow =
    sheet.getLastRow();

  const lastColumn =
    sheet.getLastColumn();


  if (lastRow > 1) {

    sheet
      .getRange(
        2,
        1,
        lastRow - 1,
        lastColumn
      )
      .sort({
        column: 1,
        ascending: false
      });

  }

}


/***********************
 * 17. EXTRACT PDF TEXT
 ***********************/

function extractPdfText(
  file
) {

  /*
   * Convert PDF to temporary Google Doc.
   *
   * Requires Advanced Drive Service.
   *
   * In Apps Script:
   * Services → + → Drive API
   */

  const blob =
    file.getBlob();


  const resource = {

    name:
      CONFIG.TEMP_DOC_PREFIX +
      file.getName(),

    mimeType:
      MimeType.GOOGLE_DOCS

  };


  let tempFile;


  try {

    tempFile =
      Drive.Files.create(
        resource,
        blob,
        {
          fields:
            'id,name'
        }
      );


  } catch (error) {

    throw new Error(
      'PDF → Google Doc conversion failed. ' +
      'Make sure the Advanced Drive Service is enabled. ' +
      error.message
    );

  }


  const tempDocId =
    tempFile.id;


  try {

    const doc =
      DocumentApp.openById(
        tempDocId
      );


    const text =
      doc
        .getBody()
        .getText();


    return text;

  } finally {

    try {

      DriveApp
        .getFileById(
          tempDocId
        )
        .setTrashed(
          true
        );

    } catch (cleanupError) {

      console.warn(
        'Could not delete temporary OCR document: ' +
        cleanupError.message
      );

    }

  }

}


/***********************
 * 18. CLEANUP TEMP DOCS
 ***********************/

function cleanupTemporaryDocuments() {

  /*
   * Temporary documents are deleted
   * immediately after extraction.
   *
   * This function is retained as a
   * safety cleanup.
   */

  const files =
    DriveApp
      .searchFiles(
        "title contains '" +
        CONFIG.TEMP_DOC_PREFIX +
        "' and trashed = false"
      );


  while (
    files.hasNext()
  ) {

    try {

      files
        .next()
        .setTrashed(
          true
        );

    } catch (error) {

      console.warn(
        'Temporary cleanup failed: ' +
        error.message
      );

    }

  }

}


/***********************
 * 19. EXTRACT DATE
 * FROM PDF FILENAME
 ***********************/

function extractDateFromFilename(
  fileName
) {

  const name =
    String(
      fileName || ''
    )
      .replace(
        /\.pdf$/i,
        ''
      )
      .trim();


  let match;


  /*
   * YYYY-MM-DD
   * YYYY_MM_DD
   * YYYY.MM.DD
   */

  match =
    name.match(
      /\b(20\d{2})[-_.](\d{1,2})[-_.](\d{1,2})\b/
    );


  if (match) {

    return formatDateParts(
      match[1],
      match[2],
      match[3]
    );

  }


  /*
   * DD-MM-YYYY
   * DD_MM_YYYY
   * DD.MM.YYYY
   */

  match =
    name.match(
      /\b(\d{1,2})[-_.](\d{1,2})[-_.](20\d{2})\b/
    );


  if (match) {

    return formatDateParts(
      match[3],
      match[2],
      match[1]
    );

  }


  const months = {

    january: 1,
    jan: 1,

    february: 2,
    feb: 2,

    march: 3,
    mar: 3,

    april: 4,
    apr: 4,

    may: 5,

    june: 6,
    jun: 6,

    july: 7,
    jul: 7,

    august: 8,
    aug: 8,

    september: 9,
    sep: 9,
    sept: 9,

    october: 10,
    oct: 10,

    november: 11,
    nov: 11,

    december: 12,
    dec: 12

  };


  /*
   * DD Month YYYY
   */

  match =
    name.match(
      /\b(\d{1,2})[\s_-]+([A-Za-z]+)[\s_-]+(20\d{2})\b/i
    );


  if (
    match &&
    months[
      match[2].toLowerCase()
    ]
  ) {

    return formatDateParts(
      match[3],
      months[
        match[2].toLowerCase()
      ],
      match[1]
    );

  }


  /*
   * Month DD YYYY
   */

  match =
    name.match(
      /\b([A-Za-z]+)[\s_-]+(\d{1,2})[\s_-]+(20\d{2})\b/i
    );


  if (
    match &&
    months[
      match[1].toLowerCase()
    ]
  ) {

    return formatDateParts(
      match[3],
      months[
        match[1].toLowerCase()
      ],
      match[2]
    );

  }


  /*
   * DDMonYYYY
   *
   * Example:
   * 12Aug2026
   */

  match =
    name.match(
      /\b(\d{1,2})[\s_-]*([A-Za-z]{3,9})[\s_-]*(20\d{2})\b/i
    );


  if (
    match &&
    months[
      match[2].toLowerCase()
    ]
  ) {

    return formatDateParts(
      match[3],
      months[
        match[2].toLowerCase()
      ],
      match[1]
    );

  }


  return 'Not verified';

}


/***********************
 * 20. FORMAT DATE
 ***********************/

function formatDateParts(
  year,
  month,
  day
) {

  year =
    Number(year);

  month =
    Number(month);

  day =
    Number(day);


  const date =
    new Date(
      year,
      month - 1,
      day
    );


  /*
   * Validate date.
   */

  if (
    date.getFullYear() !== year ||
    date.getMonth() !== month - 1 ||
    date.getDate() !== day
  ) {

    return 'Not verified';

  }


  return Utilities.formatDate(
    date,
    Session.getScriptTimeZone() ||
      'Asia/Kolkata',
    'yyyy-MM-dd'
  );

}


/***********************
 * 21. NORMALISE %
 ***********************/

function normalisePercentage(
  value
) {

  const number =
    parseFloat(
      String(
        value
      )
        .replace(
          '%',
          ''
        )
        .trim()
    );


  if (
    isNaN(number)
  ) {

    return safeValue(
      value
    );

  }


  return (
    Math.round(
      number * 10
    ) / 10
  ) + '%';

}


/***********************
 * 22. FINAL SYSTEM SETUP
 ***********************/

/*
 * RUN THIS ONCE.
 *
 * It creates a NEW Answers sheet
 * with the final column structure.
 *
 * Your old Answers sheet is renamed
 * to Answers_Archive_DATE_TIME.
 *
 * Your old data is NOT deleted.
 */

function setupFinalSystem() {

  const ss =
    SpreadsheetApp
      .getActiveSpreadsheet();


  if (!ss) {

    throw new Error(
      'This script is not bound to a Google Spreadsheet.'
    );

  }


  const current =
    ss.getSheetByName(
      CONFIG.SHEET_NAME
    );


  const archiveName =
    'Answers_Archive_' +
    Utilities.formatDate(
      new Date(),
      Session.getScriptTimeZone() ||
        'Asia/Kolkata',
      'yyyyMMdd_HHmmss'
    );


  /*
   * Archive old sheet.
   */

  if (
    current &&
    current.getLastRow() > 0
  ) {

    current.setName(
      archiveName
    );


    console.log(
      'Old Answers tab archived as: ' +
      archiveName
    );

  } else if (
    current
  ) {

    ss.deleteSheet(
      current
    );

  }


  /*
   * Create clean final sheet.
   */

  const sheet =
    ss.insertSheet(
      CONFIG.SHEET_NAME
    );


  ensureHeaders(
    sheet
  );


  console.log(
    '=========================================='
  );

  console.log(
    'FINAL SYSTEM SETUP COMPLETED'
  );

  console.log(
    'Sheet: ' +
    CONFIG.SHEET_NAME
  );

  console.log(
    'Columns: ' +
    HEADERS.length
  );

  console.log(
    '=========================================='
  );

}


/***********************
 * 23. TEST GEMINI ONLY
 ***********************/

/*
 * Run this ONLY if you want to
 * verify Gemini connection.
 *
 * It makes exactly ONE request.
 */

function testGeminiConnection() {

  const apiKey =
    getGeminiApiKey();


  if (!apiKey) {

    throw new Error(
      'GEMINI_API_KEY not found.'
    );

  }


  const url =
    'https://generativelanguage.googleapis.com/v1beta/models/' +
    CONFIG.MODEL +
    ':generateContent?key=' +
    encodeURIComponent(
      apiKey
    );


  const payload = {

    contents: [

      {

        role: 'user',

        parts: [

          {

            text:
              'Reply with exactly: GEMINI TEST OK'

          }

        ]

      }

    ],

    generationConfig: {

      responseMimeType:
        'text/plain'

    }

  };


  const response =
    UrlFetchApp.fetch(
      url,
      {

        method:
          'post',

        contentType:
          'application/json',

        payload:
          JSON.stringify(
            payload
          ),

        muteHttpExceptions:
          true

      }
    );


  const statusCode =
    response.getResponseCode();


  const responseText =
    response.getContentText();


  Logger.log(
    'GEMINI HTTP STATUS: ' +
    statusCode
  );


  Logger.log(
    'GEMINI RESPONSE: ' +
    responseText
  );


  if (
    statusCode !== 200
  ) {

    throw new Error(
      'Gemini connection test failed. HTTP ' +
      statusCode +
      ': ' +
      responseText
    );

  }


  Logger.log(
    'GEMINI CONNECTION TEST SUCCESSFUL.'
  );

}


/***********************
 * 24. WEB APP ENDPOINT
 * (for AnswerOS live sync)
 ***********************/

/*
 * DEPLOY AS WEB APP:
 *   Deploy → New deployment → Web app
 *   Execute as: Me
 *   Who has access: Anyone with the link
 *
 * OPTIONAL SECURITY:
 *   Script Properties → add SYNC_TOKEN = <any secret string>.
 *   If set, requests must include ?token=<that same string>.
 *   If not set, the endpoint is open to anyone with the URL —
 *   fine for a personal tool, but set a token if you'd rather
 *   not have it publicly readable.
 *
 * RESPONSE:
 *   { "ok": true, "rows": [ {header: value, ...}, ... ] }
 */

function doGet(e) {

  try {

    const requiredToken =
      PropertiesService
        .getScriptProperties()
        .getProperty('SYNC_TOKEN');


    if (requiredToken) {

      const providedToken =
        e && e.parameter ?
          e.parameter.token :
          null;


      if (providedToken !== requiredToken) {

        return ContentService
          .createTextOutput(
            JSON.stringify({
              ok: false,
              error: 'Invalid or missing token.'
            })
          )
          .setMimeType(
            ContentService.MimeType.JSON
          );

      }

    }


    const sheet =
      getSheet();


    const lastRow =
      sheet.getLastRow();


    const lastColumn =
      sheet.getLastColumn();


    if (lastRow < 2) {

      return ContentService
        .createTextOutput(
          JSON.stringify({
            ok: true,
            rows: []
          })
        )
        .setMimeType(
          ContentService.MimeType.JSON
        );

    }


    const values =
      sheet
        .getRange(
          1,
          1,
          lastRow,
          lastColumn
        )
        .getValues();


    const headerRow =
      values[0];


    const rows =
      values
        .slice(1)
        .filter(function(row) {

          // Skip fully blank trailing rows
          return row.some(function(cell) {
            return cell !== '' && cell !== null;
          });

        })
        .map(function(row) {

          const obj = {};

          headerRow.forEach(
            function(header, i) {

              obj[header] = row[i];

            }
          );

          return obj;

        });


    return ContentService
      .createTextOutput(
        JSON.stringify({
          ok: true,
          rows: rows
        })
      )
      .setMimeType(
        ContentService.MimeType.JSON
      );


  } catch (error) {

    return ContentService
      .createTextOutput(
        JSON.stringify({
          ok: false,
          error: error.message
        })
      )
      .setMimeType(
        ContentService.MimeType.JSON
      );

  }

}
