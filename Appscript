function extractWordCountFromText(
  pdfText
) {

  const match =
    pdfText.match(
      /Your Word Count:\s*(\d+)/i
    );


  return match ?
    Number(match[1]) :
    '';

}


function extractMarksFromText(
  pdfText
) {

  const match =
    pdfText.match(
      /Marks scored:\s*(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/i
    );


  if (!match) {

    return {
      marks: '',
      max: ''
    };

  }


  return {
    marks: Number(match[1]),
    max: Number(match[2])
  };

}


