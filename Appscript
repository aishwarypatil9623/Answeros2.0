function testOnePdf() {

  const apiKey =
    getGeminiApiKey();

  const sheet =
    getSheet();

  ensureHeaders(sheet);

  const processedIds =
    getProcessedPdfIds(sheet);

  const folder =
    DriveApp.getFolderById(
      CONFIG.PDF_FOLDER_ID
    );

  const files =
    folder.getFilesByType(
      MimeType.PDF
    );

  if (!files.hasNext()) {
    throw new Error(
      'No PDF found in the SuperKalam folder.'
    );
  }

  const file =
    files.next();

  const fileId =
    file.getId();

  console.log(
    'TESTING ONE PDF: ' +
    file.getName()
  );

  if (processedIds.has(fileId)) {

    console.log(
      'This PDF is already processed. Test stopped.'
    );

    return;
  }

  processSinglePdf(
    file,
    sheet,
    apiKey
  );

  console.log(
    'ONE-PDF TEST COMPLETED.'
  );
}
/***********************
 * 4. PROCESS ONE PDF
 ***********************/

function processSinglePdf(
  file,
  sheet,
  apiKey,
  modelName
) {

  const pdfLink = `=HYPERLINK("${file.getUrl()}","${file.getName()}")`;


  const fileName =
    file.getName();


  /*
   * Extract date from filename
   */

  const filenameDate =
    extractDateFromFilename(
      fileName
    );


  console.log(
    'DATE FROM FILENAME: ' +
    filenameDate
  );


  /*
   * Extract PDF text
   */

  const pdfText =
    extractPdfText(
      file
    );


  if (
    !pdfText ||
    pdfText.trim().length < 100
  ) {

    throw new Error(
      'PDF text extraction failed or returned insufficient text.'
    );

  }


  console.log(
    'TEXT LENGTH: ' +
    pdfText.length
  );


  /*
   * Regex-extract Word Count + Marks BEFORE Gemini.
   * These come straight from SuperKalam's own PDF text —
   * no LLM transcription risk.
   */

  const wordCount =
    extractWordCountFromText(
      pdfText
    );


  const extractedMarks =
    extractMarksFromText(
      pdfText
    );


  console.log(
    'WORD COUNT (regex): ' +
    wordCount
  );


  console.log(
    'MARKS (regex): ' +
    extractedMarks.marks +
    '/' +
    extractedMarks.max
  );


  console.log(
    'Sending evaluation to Gemini...'
  );


  /*
   * Gemini analysis
   */

  const result =
    callGemini(
      apiKey,
      pdfText,
      filenameDate,
      modelName || CONFIG.MODEL
    );


  console.log(
    'Gemini analysis completed.'
  );


  /*
   * Cross-check Gemini's marks against the regex-extracted
   * ground truth from the PDF itself.
   */

  const marksVerified =
    extractedMarks.marks === '' ? 'N/A' :
    (String(extractedMarks.marks) === String(result.marks) &&
     String(extractedMarks.max) === String(result.max_marks)) ? 'MATCH' : 'MISMATCH';


  if (marksVerified === 'MISMATCH') {

    console.warn(
      'MARKS MISMATCH — Gemini: ' +
      result.marks + '/' + result.max_marks +
      ' | PDF regex: ' +
      extractedMarks.marks + '/' + extractedMarks.max
    );

  }


  /*
   * Build Sheet row
   */

  const row =
  buildSheetRow(
    result,
    pdfLink,
    file.getId(),
    wordCount,
    marksVerified
  );


  sheet.appendRow(
    row
  );
  
const writtenRow = sheet.getLastRow();

for (let col = 1; col <= row.length; col++) {
  formatRecallHighlights(
    sheet,
    writtenRow,
    col,
    row[col - 1]
  );
}

  console.log(
    'SUCCESSFULLY WRITTEN TO SHEET'
  );


  /*
   * Keep the sheet sorted newest-first after every
   * successful write, not just after failures.
   */

  sortAnswersByDate(
    sheet
  );


  console.log(
    'SHEET RE-SORTED BY DATE'
  );


  /*
   * Delete temporary OCR document
   */

  cleanupTemporaryDocuments();


  console.log(
    'TEMP DOC DELETED'
  );


  /*
   * Original PDF retained
   */

  console.log(
    'ORIGINAL PDF RETAINED — TEST MODE'
  );

}


