function processSuperKalamAnswers() {

  const lock =
    LockService.getScriptLock();

  try {

    lock.waitLock(30000);

    console.log(
      '=========================================='
    );

    console.log(
      'SUPERKALAM PROCESSING STARTED'
    );

    console.log(
      '=========================================='
    );


    const apiKey =
      getGeminiApiKey();


    if (!apiKey) {

      throw new Error(
        'Gemini API key not found. Add GEMINI_API_KEY to Script Properties.'
      );

    }


    const sheet =
      getSheet();


    ensureHeaders(
      sheet
    );


    const processedIds =
      getProcessedPdfIds(
        sheet
      );

    const retryPendingIds =
      getRetryPendingPdfIds(
        sheet
      );


    const folder =
      DriveApp.getFolderById(
        CONFIG.PDF_FOLDER_ID
      );


    const files =
      folder.getFilesByType(
        MimeType.PDF
      );


    let processed = 0;
    let skipped = 0;
    let failed = 0;


    while (
      files.hasNext() &&
      processed < CONFIG.MAX_FILES_PER_RUN
    ) {

      const file =
        files.next();


      const fileId = file.getId();


      const fileName =
        file.getName();


      console.log(
        '------------------------------------------'
      );


      console.log(
        'PDF FOUND: ' +
        fileName
      );


      /*
       * Duplicate protection
       */

      if (
        processedIds.has(
          fileId
        )
      ) {

        console.log(
          'Already processed: ' +
          fileName
        );

        skipped++;

        continue;
      }

      /*
       * A PDF waiting for the 15-minute fallback must not
       * be picked up by the normal primary-model run.
       */
      if (
        retryPendingIds.has(
          fileId
        )
      ) {

        console.log(
          'Waiting for fallback retry: ' +
          fileName
        );

        skipped++;

        continue;
      }


      try {

        processSinglePdf(
          file,
          sheet,
          apiKey
        );


        processed++;


        console.log(
          'PROCESSING SUCCESSFUL: ' +
          fileName
        );


      } catch (error) {

        failed++;


        console.error(
          'PROCESSING FAILED: ' +
          fileName +
          ' | ' +
          error.message
        );


        writeFailureRow(
          sheet,
          file,
          error
        );

      }

    }


    console.log(
      '=========================================='
    );

    console.log(
      'FINISHED'
    );

    console.log(
      'Processed: ' +
      processed
    );

    console.log(
      'Skipped: ' +
      skipped
    );

    console.log(
      'Failed: ' +
      failed
    );

    console.log(
      '=========================================='
    );


  } finally {

    try {

      lock.releaseLock();

    } catch (e) {}

  }

}
