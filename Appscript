function formatRecallHighlights(sheet, row, column, value) {

  if (!value || typeof value !== 'string') return;

  // Support both correct and malformed closing markers
  const regex = /\[MUST\](.*?)(?:\[\/MUST\]|\[MUST\])/g;

  let match;
  let matches = [];

  while ((match = regex.exec(value)) !== null) {
    matches.push({
      fullStart: match.index,
      fullLength: match[0].length,
      term: match[1]
    });
  }

  if (matches.length === 0) return;

  // Remove all MUST markers from displayed text
  const cleanText = value
    .replace(/\[MUST\](.*?)\[\/MUST\]/g, '$1')
    .replace(/\[MUST\](.*?)\[MUST\]/g, '$1');

  const builder = SpreadsheetApp
    .newRichTextValue()
    .setText(cleanText);

  matches.forEach(function(match) {

    // Determine where the term appears in the cleaned text
    const beforeText = value.substring(
      0,
      match.fullStart
    );

    const cleanedBefore = beforeText
      .replace(/\[MUST\](.*?)\[\/MUST\]/g, '$1')
      .replace(/\[MUST\](.*?)\[MUST\]/g, '$1');

    const start = cleanedBefore.length;
    const end = start + match.term.length;

    builder.setTextStyle(
      start,
      end,
      SpreadsheetApp
        .newTextStyle()
        .setBold(true)
        .build()
    );
  });

  sheet
    .getRange(row, column)
    .setRichTextValue(builder.build());
}

