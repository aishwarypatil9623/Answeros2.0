{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnswerOS Mentor Output",
  "type": "object",
  "required": ["diagnosis", "progress", "intervention", "mentor_message"],
  "properties": {
    "diagnosis": {
      "type": "object",
      "required": ["primary_issue", "severity", "confidence", "evidence"],
      "properties": {
        "primary_issue": {"type": "string"},
        "secondary_issue": {"type": ["string", "null"]},
        "severity": {"enum": ["observe", "emerging", "high", "critical"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "pattern_type": {"enum": ["isolated", "emerging", "persistent", "intervention_failure", "improving", "stable"]}
      }
    },
    "progress": {
      "type": "object",
      "required": ["improved", "stable", "declined"],
      "properties": {
        "improved": {"type": "array", "items": {"type": "string"}},
        "stable": {"type": "array", "items": {"type": "string"}},
        "declined": {"type": "array", "items": {"type": "string"}}
      }
    },
    "intervention": {
      "type": "object",
      "required": ["action", "duration_answers", "success_metric", "do_not_do"],
      "properties": {
        "action": {"type": "string"},
        "duration_answers": {"type": "integer", "minimum": 1, "maximum": 20},
        "success_metric": {"type": "string"},
        "do_not_do": {"type": "array", "items": {"type": "string"}},
        "review_condition": {"type": "string"}
      }
    },
    "mentor_message": {"type": "string"},
    "confidence_note": {"type": ["string", "null"]}
  }
}
